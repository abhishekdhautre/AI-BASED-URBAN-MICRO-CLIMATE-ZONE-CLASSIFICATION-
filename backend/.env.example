# Backend environment variables
# Copy to .env and fill in values

# Path to the trained .h5 model (relative to backend/)
MODEL_PATH=models/model.h5

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------------------
# MODEL INPUT CONFIGURATION
# Adjust these to match your training pipeline exactly.
# -------------------------------------------------------

# Total input channels expected by the model
INPUT_CHANNELS=18

# Input spatial dimensions (height, width)
INPUT_HEIGHT=32
INPUT_WIDTH=32

# Channel order description (informational)
# S1: VV, VH, VV/VH, VH/VV  |  S2: B2,B3,B4,B5,B6,B7,B8,B8A,B11,B12 + 4 indices
CHANNEL_ORDER=S1_VV,S1_VH,S1_VV_VH,S1_VH_VV,S2_B2,S2_B3,S2_B4,S2_B5,S2_B6,S2_B7,S2_B8,S2_B8A,S2_B11,S2_B12,S2_NDVI,S2_NDBI,S2_MNDWI,S2_EVI

# Normalization strategy: "minmax", "zscore", or "none"
NORMALIZATION=minmax
